# Copy this file to ".env" and change the values. ".env" is ignored by git.

# Port the API listens on (default 3000)
PORT=3000

# Folders the API may analyze, separated by ";" on Windows and ":" on Linux/macOS.
# Leave empty to allow ANY folder (only do that on your own computer).
ALLOWED_ROOTS=

# Web page addresses allowed to call the API from a browser, separated by ",".
# Default: the Vite dev server (http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Set to "false" to stop the API from downloading GitHub repositories (needs git).
# Default: downloads are allowed.
ALLOW_GITHUB=true

# --- Settings for a public server (see docs/deployment.md) ---

# Set to "false" so strangers cannot make the server read its own folders.
ALLOW_LOCAL_PATHS=true

# How many projects are kept in memory (one per visitor), and for how long when unused.
MAX_PROJECTS=20
PROJECT_TTL_MINUTES=30

# Limits for one project: JavaScript files, and the size of a downloaded repository.
MAX_FILES=3000
MAX_REPO_MB=200

# How many GitHub downloads may run at the same time.
MAX_DOWNLOADS=2

# How many analyze requests one visitor may make in a period of time.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MINUTES=10

